# ── RUNTIME API (Python backend) ──────────────────────────────────────────────
# URL du runtime évaluateur — SERVER-ONLY (jamais exposé au browser).
# En dev local : http://127.0.0.1:8796
# En production : pointer vers le service Railway (https://…railway.app)
RUNTIME_API_URL=http://127.0.0.1:8796

# Token d'authentification backend (optionnel en dev, requis en prod)
# Doit correspondre à EVAL_RUNTIME_API_TOKEN dans l'env Railway
# RUNTIME_API_TOKEN=

# Origine autorisée pour CORS côté Python runtime (optionnel en dev)
# En prod : https://votre-domaine.com (une seule origine)
# EVAL_RUNTIME_ALLOWED_ORIGIN=*

# ── SUPABASE (auth scaffolding — non actif en V1) ─────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
