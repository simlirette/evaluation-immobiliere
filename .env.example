# ── RUNTIME API (Python backend — Railway) ────────────────────────────────────
# URL du runtime évaluateur — SERVER-ONLY (jamais exposé au browser).
# En dev local : http://127.0.0.1:8796
# En production : URL du service Railway (ex: https://eval-immo-runtime.railway.app)
RUNTIME_API_URL=http://127.0.0.1:8796

# Token d'authentification partagé entre le BFF Next.js et le backend Python.
# Doit correspondre exactement à EVAL_RUNTIME_API_TOKEN dans l'env Railway.
# Générer avec : openssl rand -hex 32
# RUNTIME_API_TOKEN=

# ── RUNTIME PYTHON BACKEND (Railway — variables côté Python) ──────────────────
# Token attendu par le backend Python. Doit être identique à RUNTIME_API_TOKEN ci-dessus.
# EVAL_RUNTIME_API_TOKEN=

# Active les validations strictes de production au demarrage backend.
# APP_ENV=production

# Origine CORS autorisée (backend Python). En prod : URL Vercel exacte, sans slash final.
# Ex: https://eval-immo.vercel.app
# EVAL_RUNTIME_ALLOWED_ORIGIN=*

# Répertoire de stockage des sessions runtime.
# En dev local : omis (utilise backend/runtime_sessions/ par défaut)
# En prod Railway avec volume persistant : chemin du volume monté (ex: /data/sessions)
# SESSIONS_DIR=

# Repertoire persistant pour caches de sources publiques (MAMH, Infolot, SIRF local).
# En dev local : omis (utilise backend/data_cache/ par defaut)
# En prod Railway avec volume persistant : ex. /data/data_cache
# DATA_CACHE_DIR=

# Smoke tests externes opt-in seulement. Voir docs/EXTERNAL-SOURCE-SMOKE.md.
# EVAL_IMMO_LIVE_EXTERNALS=0
# EVAL_IMMO_LIVE_SIRF=0
# SIRF_TEST_LOT=

# ── LLM AGENT (OpenAI GPT) ────────────────────────────────────────────────────
# Si absent, les agents utilisent le mode déterministe (réponses structurées).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── SUPABASE AUTH (Next.js — Vercel) ─────────────────────────────────────────
# Requis en production pour protéger /dossiers et /dossier/*.
# Si absent, l'app fonctionne sans auth (dev local uniquement).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
