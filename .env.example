# ── RUNTIME API (Python backend) ──────────────────────────────────────────────
# URL du runtime évaluateur — SERVER-ONLY (jamais exposé au browser).
# En dev local : http://127.0.0.1:8796
# En production : pointer vers le service Railway (https://…railway.app)
RUNTIME_API_URL=http://127.0.0.1:8796

# Token d'authentification backend (optionnel en dev, requis en prod)
# Doit correspondre à EVAL_RUNTIME_API_TOKEN dans l'env Railway
# RUNTIME_API_TOKEN=

# Origine autorisée pour CORS côté Python runtime (optionnel en dev)
# En prod : https://votre-domaine.com (une seule origine)
# EVAL_RUNTIME_ALLOWED_ORIGIN=*

# ── LLM AGENT (Anthropic Claude) ──────────────────────────────────────────────
# Si absent, les agents utilisent le mode déterministe (réponses structurées).
# Si présent, les agents appellent Claude pour des réponses en langage naturel.
# ANTHROPIC_API_KEY=sk-ant-...
# Modèle par défaut : claude-haiku-4-5-20251001 (rapide/économique)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── SUPABASE AUTH ─────────────────────────────────────────────────────────────
# Requis en production pour protéger /dossiers et /dossier/*.
# Si absent, l'app fonctionne sans auth (dev local uniquement).
# Créer les utilisateurs via le dashboard Supabase (invite-only — pas de signup public).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
